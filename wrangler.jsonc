{
  // Cloudflare Workers (static assets only — no worker script).
  // Admin auth is Supabase Auth; no custom API endpoints remain.
  "name": "golftour-claude",
  "compatibility_date": "2026-07-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
  // Build variables (Workers Builds settings): VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
  // Worker secrets: none needed anymore (ADMIN_PIN obsolete).
}
